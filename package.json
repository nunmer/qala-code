{
  "name": "qala-code",
  "version": "0.1.0",
  "private": true,
  "description": "QALA CODE — интерактивная карта истории улиц Астаны",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "npx --yes serve out",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^5.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
