# Базовый URL, который зашивается в QR-коды (§17 README).
# Если не задан - используется window.location.origin текущей вкладки,
# поэтому локально QR-коды тоже работают.
NEXT_PUBLIC_SITE_URL=https://qalacode.kz

# Учётные данные демонстрационного входа в редактор данных (/admin).
# По умолчанию admin / admin.
#
# ЭТО НЕ СЕКРЕТ. Приложение статическое: любая переменная NEXT_PUBLIC_*
# попадает в бандл и видна в исходниках страницы, а проверка выполняется
# в браузере. Форма входа лишь закрывает редактор от случайного посетителя.
# Для настоящего разграничения доступа нужен бэкенд с серверной проверкой.
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin

# ВАЖНО: ключ LLM сюда НЕ кладётся по той же причине.
# Ключ вводится пользователем в интерфейсе AI-гида и хранится
# только в localStorage его браузера.
